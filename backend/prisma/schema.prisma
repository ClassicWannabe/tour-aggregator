generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Supplier {
  id              String       @id @default(uuid()) @db.Uuid
  type            SupplierType
  email           String       @unique
  emailVerifiedAt DateTime?
  password        String
  socialLinks     String[]
  aboutMe         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tours             Tour[]
  supplierUploads   SupplierUpload[]
  verificationCodes VerificationCode[]

  companySupplier    CompanySupplier?
  individualSupplier IndividualSupplier?
}

model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  expireAt  DateTime
  createdAt DateTime @default(now())

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

enum SupplierType {
  CompanySupplier
  IndividualSupplier
}

model CompanySupplier {
  id          String @id @default(uuid()) @db.Uuid
  ownerName   String
  companyName String

  supplierId String   @unique @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model IndividualSupplier {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String

  supplierId String   @unique @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model SupplierUpload {
  id          String   @id @default(uuid()) @db.Uuid
  storageLink String
  createdAt   DateTime @default(now())

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Tour {
  id                   String   @id @default(uuid()) @db.Uuid
  title                String
  thesis               String
  description          String
  transportDescription String?
  pricePerPerson       Int
  peopleCount          Int
  contacts             String[]
  highlights           String[]
  inclusions           String[]
  exclusions           String[]
  startDate            DateTime
  endDate              DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  itineraries TourItinerary[]
  photos      TourPhoto[]

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model TourPhoto {
  id                           String   @id @default(uuid()) @db.Uuid
  originalStorageLink          String
  compressedMediumStorageLink  String
  compressedPreviewStorageLink String
  createdAt                    DateTime @default(now())

  tourId String @db.Uuid
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourItinerary {
  id          String   @id @default(uuid()) @db.Uuid
  time        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tourId String @db.Uuid
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}
