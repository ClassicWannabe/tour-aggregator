generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "omitApi", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DB_URL")
  extensions = [pg_trgm]
}

model Supplier {
  id              String       @id @default(uuid()) @db.Uuid
  type            SupplierType
  email           String       @unique
  emailVerifiedAt DateTime?
  password        String
  socialLinks     String[]
  aboutMe         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tours             Tour[]
  supplierUploads   SupplierUpload[]
  verificationCodes VerificationCode[]

  companySupplier    CompanySupplier?
  individualSupplier IndividualSupplier?
  TourPhoto          TourPhoto[]
}

model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  expireAt  DateTime
  createdAt DateTime @default(now())

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

enum SupplierType {
  COMPANY_SUPPLIER
  INDIVIDUAL_SUPPLIER
}

model CompanySupplier {
  id          String @id @default(uuid()) @db.Uuid
  ownerName   String
  companyName String

  supplierId String   @unique @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model IndividualSupplier {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String

  supplierId String   @unique @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model SupplierUpload {
  id          String   @id @default(uuid()) @db.Uuid
  storageLink String
  createdAt   DateTime @default(now())

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

enum TourType {
  WALKING
  CITY
  FIELD
}

model Tour {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String
  thesis              String
  description         String
  isTransportIncluded Boolean
  pricePerPerson      Int?
  peopleCount         Int
  type                TourType
  inclusions          String[]
  exclusions          String[]
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  program             Json

  photos TourPhoto[]

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  dates TourDate[]
}

model TourDate {
  id        String   @id @default(uuid()) @db.Uuid
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourId String @db.Uuid
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  tourReservation TourReservation[]
}

model TourReservation {
  id          String @id @default(uuid()) @db.Uuid
  email       String
  phoneNumber String

  tourDate   TourDate @relation(fields: [tourDateId], references: [id])
  tourDateId String   @db.Uuid
}

model TourPhoto {
  id                           String    @id @default(uuid()) @db.Uuid
  originalStorageLink          String
  compressedMediumStorageLink  String
  compressedPreviewStorageLink String
  order                        Int?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  tourId String? @db.Uuid
  tour   Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String   @db.Uuid
}

model Location {
  id   String @id @default(uuid()) @db.Uuid
  name String

  tour Tour[]
}
