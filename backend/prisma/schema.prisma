generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "omitApi", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DB_URL")
  extensions = [pg_trgm]
}

model Supplier {
  id          String       @id @default(uuid()) @db.Uuid
  type        SupplierType
  email       String?
  phone       String?
  password    String
  socialLinks String[]
  aboutMe     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tours             Tour[]
  certificates      SupplierCertificateUpload[]
  verificationCodes SupplierContactVerification[]

  companySupplier    CompanySupplier?
  individualSupplier IndividualSupplier?
  photo              SupplierProfilePhotoUpload?
  tourPhotos         TourPhoto[]

  @@index([email])
  @@index([phone])
}

enum SupplierContactType {
  EMAIL
  PHONE
}

model SupplierContactVerification {
  id                String              @id @default(uuid()) @db.Uuid
  code              String
  codeExpiresAt     DateTime
  contact           String
  type              SupplierContactType
  contactVerifiedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@index([contact])
}

enum SupplierType {
  COMPANY_SUPPLIER
  INDIVIDUAL_SUPPLIER
}

model CompanySupplier {
  id          String @id @default(uuid()) @db.Uuid
  ownerName   String
  companyName String

  supplierId String   @unique @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model IndividualSupplier {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String

  supplierId String   @unique @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SupplierProfilePhotoUpload {
  id                           String   @id @default(uuid()) @db.Uuid
  originalStorageLink          String
  compressedMediumStorageLink  String
  compressedPreviewStorageLink String
  originalStorageKey           String
  compressedMediumStorageKey   String
  compressedPreviewStorageKey  String
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  supplierId String   @unique @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SupplierCertificateUpload {
  id          String   @id @default(uuid()) @db.Uuid
  storageLink String
  storageKey  String
  order       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

enum TourType {
  WALKING
  CITY
  FIELD
}

model Tour {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String
  thesis              String
  description         String
  isTransportIncluded Boolean
  pricePerPerson      Int
  peopleCount         Int
  type                TourType
  inclusions          String[]
  exclusions          String[]
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  program             Json

  photos TourPhoto[]

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  dates TourDate[]
}

model TourDate {
  id        String   @id @default(uuid()) @db.Uuid
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourId String @db.Uuid
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  tourReservation TourReservation[]
}

model TourReservation {
  id          String   @id @default(uuid()) @db.Uuid
  email       String
  phoneNumber String
  name        String
  createdAt   DateTime @default(now())

  tourDate   TourDate @relation(fields: [tourDateId], references: [id], onDelete: Cascade)
  tourDateId String   @db.Uuid
}

model TourPhoto {
  id                           String   @id @default(uuid()) @db.Uuid
  originalStorageLink          String
  compressedMediumStorageLink  String
  compressedPreviewStorageLink String
  originalStorageKey           String
  compressedMediumStorageKey   String
  compressedPreviewStorageKey  String
  order                        Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  tourId String? @db.Uuid
  tour   Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String   @db.Uuid
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour[]
}
